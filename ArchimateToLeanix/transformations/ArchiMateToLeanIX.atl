unique lazy rule CreateLogicalInterfaceFromFlow {
    from
        r : ARCHIMATE!FlowRelationship
    to
        out : LEANIX!Interface (

        id <- 'flow-interface-' + r.id,
        externalId <- 'flow-interface-' + r.id,

        name <- r.logicalInterfaceName(),

        description <-
            if r.safeDocumentation() = '' then
                'Generated from ArchiMate application-level flow relationship.'
            else
                'Generated from ArchiMate application-level flow relationship. ' +
                r.safeDocumentation()
            endif,

        factSheetTypeKey <- 'interface',
        factSheetTypeLabel <- 'Interface',

        factSheetSubtypeKey <- 'logicalInterface',
        factSheetSubtypeLabel <- 'Logical Interface',

        dataFlowDirection <-
            if r.formsSimpleBidirectionalPair() then
                #BI_DIRECTIONAL
            else
                #OUTGOING
            endif,

        isCustomType <- false,


        mappingRuleId <- 'REL-A-09'
    	)
}

unique lazy rule TraceLogicalInterfaceFromFlow {
    from
        r : ARCHIMATE!FlowRelationship
    to
        trace : TRACE!TraceLink (
            id <- 'trace-REL-A-09-INTERFACE-' + r.id,
            ruleId <- 'REL-A-09',
            kind <- #DIRECT,

            sourceArtifacts <-
                r.flowEvidence()
                    ->collect(a |
                        thisModule.CreateTraceSourceArtifactReference(a)
                    )
                    ->asSequence(),

            targetArtifact <- targetRef
        ),

        targetRef : TRACE!FactSheetTargetReference (
            artifactId <- 'flow-interface-' + r.id,
            artifactType <- 'Interface',
            targetObject <- thisModule.CreateLogicalInterfaceFromFlow(r)
        )
}

