helper def : explicitDataObjectBusinessObjectRealizations() : Sequence(ARCHIMATE!RealizationRelationship) =
    thisModule.realizations()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!DataObject) and
        r.target.oclIsKindOf(ARCHIMATE!BusinessObject))->asSequence();

