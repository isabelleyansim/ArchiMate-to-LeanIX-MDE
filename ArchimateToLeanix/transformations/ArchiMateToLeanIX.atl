-- ============================================================================
-- Application anchored behavior navigation
-- ============================================================================

helper context ARCHIMATE!ArchimateElement def : directAssignedComponents() : Sequence(ARCHIMATE!ApplicationComponent) =
    thisModule.assignments()
        ->select(r | r.target = self and r.source.oclIsKindOf(ARCHIMATE!ApplicationComponent))
        ->collect(r | r.source)
        ->asSequence();

-- Stop traversal when behavior is explicitly assigned to another component
helper context ARCHIMATE!ArchimateElement def : isForeignAssignmentBoundary(
    anchor : ARCHIMATE!ApplicationComponent
) : Boolean =
    not self.directAssignedComponents()->isEmpty() and
    not self.directAssignedComponents()->includes(anchor);

helper context ARCHIMATE!ApplicationComponent def : directlyAssignedBehaviorSteps()
    : Sequence(OclAny) =

    thisModule.assignments()
        ->select(r |
            r.source = self and
            r.target.oclIsKindOf(ARCHIMATE!ArchimateElement) and
            (
                r.target.oclIsKindOf(ARCHIMATE!ApplicationFunction) or
                r.target.oclIsKindOf(ARCHIMATE!ApplicationProcess)
            )
        )
        ->collect(r |
            Tuple {
                relation = r,
                behavior = r.target
            }
        )
        ->asSequence();

helper context ARCHIMATE!ArchimateElement def : structuralBehaviorSteps()
    : Sequence(OclAny) =

    thisModule.compositions()
        ->select(r |
            r.source = self and
            r.target.oclIsKindOf(ARCHIMATE!ArchimateElement) and
            (
                r.target.oclIsKindOf(ARCHIMATE!ApplicationFunction) or
                r.target.oclIsKindOf(ARCHIMATE!ApplicationProcess)
            )
        )
        ->collect(r |
            Tuple {
                relation = r,
                behavior = r.target
            }
        )
        ->union(
            thisModule.aggregations()
                ->select(r |
                    r.source = self and
                    r.target.oclIsKindOf(ARCHIMATE!ArchimateElement) and
                    (
                        r.target.oclIsKindOf(ARCHIMATE!ApplicationFunction) or
                        r.target.oclIsKindOf(ARCHIMATE!ApplicationProcess)
                    )
                )
                ->collect(r |
                    Tuple {
                        relation = r,
                        behavior = r.target
                    }
                )
        )
        ->asSequence();

helper context ARCHIMATE!ArchimateElement def : anchoredStructuralPaths(
    anchor : ARCHIMATE!ApplicationComponent,
    visited : Sequence(ARCHIMATE!ArchimateElement),
    currentPath : Sequence(OclAny)
) : Sequence(OclAny) =

    if visited->includes(self) then
        Sequence{}
    else
        Sequence{
            Tuple {
                behavior = self,
                path = currentPath
            }
        }
        ->union(
            self.structuralBehaviorSteps()
                ->reject(step |
                    step.behavior.isForeignAssignmentBoundary(anchor)
                )
                ->collect(step |
                    step.behavior.anchoredStructuralPaths(
                        anchor,
                        visited->including(self),
                        currentPath
                            ->including(step.relation)
                            ->including(step.behavior)
                    )
                )
                ->flatten()
        )
        ->asSequence()
    endif;

helper context ARCHIMATE!ApplicationComponent def : anchoredBehaviorPaths()
    : Sequence(OclAny) =

    self.directlyAssignedBehaviorSteps()
        ->collect(step |
            step.behavior.anchoredStructuralPaths(
                self,
                Sequence{},
                Sequence{
                    self,
                    step.relation,
                    step.behavior
                }
            )
        )
        ->flatten()
        ->asSequence();

-- ============================================================================
-- Technology anchored behavior navigation
-- ============================================================================

helper context ARCHIMATE!ArchimateElement def : directAssignedTechnologyAnchors() : Sequence(ARCHIMATE!ArchimateElement) =
    thisModule.assignments()->select(r |
            r.target = self and
            (
                r.source.oclIsKindOf(ARCHIMATE!Node) or
                r.source.oclIsKindOf(ARCHIMATE!Device) or
                r.source.oclIsKindOf(ARCHIMATE!SystemSoftware)
            )
        )
        ->collect(r | r.source)
        ->asSequence();

helper context ARCHIMATE!ArchimateElement def : isForeignTechnologyAssignmentBoundary(
    anchor : ARCHIMATE!ArchimateElement
) : Boolean =

    not self.directAssignedTechnologyAnchors()->isEmpty() and
    not self.directAssignedTechnologyAnchors()->includes(anchor);

helper context ARCHIMATE!ArchimateElement def : directlyAssignedTechnologyBehaviorSteps()
    : Sequence(OclAny) =

    thisModule.assignments()
        ->select(r |
            r.source = self and
            (
                r.target.oclIsKindOf(ARCHIMATE!TechnologyFunction) or
                r.target.oclIsKindOf(ARCHIMATE!TechnologyProcess)
            )
        )
        ->collect(r |
            Tuple {
                relation = r,
                behavior = r.target
            }
        )
        ->asSequence();


helper context ARCHIMATE!ArchimateElement def : technologyStructuralBehaviorSteps()
    : Sequence(OclAny) =

    thisModule.compositions()
        ->select(r |
            r.source = self and
            (
                r.target.oclIsKindOf(ARCHIMATE!TechnologyFunction) or
                r.target.oclIsKindOf(ARCHIMATE!TechnologyProcess)
            )
        )
        ->collect(r |
            Tuple {
                relation = r,
                behavior = r.target
            }
        )
        ->union(
            thisModule.aggregations()
                ->select(r |
                    r.source = self and
                    (
                        r.target.oclIsKindOf(ARCHIMATE!TechnologyFunction) or
                        r.target.oclIsKindOf(ARCHIMATE!TechnologyProcess)
                    )
                )
                ->collect(r |
                    Tuple {
                        relation = r,
                        behavior = r.target
                    }
                )
        )
        ->asSequence();

helper context ARCHIMATE!ArchimateElement def : technologyAnchoredStructuralPaths(
    anchor : ARCHIMATE!ArchimateElement,
    visited : Sequence(ARCHIMATE!ArchimateElement),
    currentPath : Sequence(OclAny)
) : Sequence(OclAny) =

    if visited->includes(self) then
        Sequence{}
    else
        Sequence{
            Tuple {
                behavior = self,
                path = currentPath
            }
        }
        ->union(
            self.technologyStructuralBehaviorSteps()
                ->reject(step |
                    step.behavior.isForeignTechnologyAssignmentBoundary(anchor)
                )
                ->collect(step |
                    step.behavior.technologyAnchoredStructuralPaths(
                        anchor,
                        visited->including(self),
                        currentPath
                            ->including(step.relation)
                            ->including(step.behavior)
                    )
                )
                ->flatten()
        )
        ->asSequence()
    endif;


helper context ARCHIMATE!ArchimateElement def : technologyAnchoredBehaviorPaths()
    : Sequence(OclAny) =

    self.directlyAssignedTechnologyBehaviorSteps()
        ->collect(step |
            step.behavior.technologyAnchoredStructuralPaths(
                self,
                Sequence{},
                Sequence{
                    self,
                    step.relation,
                    step.behavior
                }
            )
        )
        ->flatten()
        ->asSequence();

-- ============================================================================
-- Derived relationship candidates
-- ============================================================================

-- APP-DER-01: Derive Application-Service realization through internal behavior
helper def : derivedRealizesServiceCandidates() : Sequence(OclAny) =
    ARCHIMATE!ApplicationComponent.allInstances()->asSequence()
        ->collect(app |

            app.anchoredBehaviorPaths()->collect(p |

                thisModule.realizations()
                    ->select(r |
                        r.source = p.behavior and
                        r.target.oclIsKindOf(ARCHIMATE!ApplicationService)
                    )
                    ->collect(r |
                        Tuple {
                            app = app,
                            service = r.target,

                            evidenceBehavior = p.behavior,
                            evidenceRelation = r,

                            traceArtifacts = p.path
                                ->including(r)
                                ->including(r.target),

                            key = app.id + '|realizesService|' + r.target.id
                        }
                    )
            )->flatten()
        )->flatten()
        ->asSequence();

-- APP-DER-02: Derive Application-Data Object access through internal behavior
helper def : derivedAccessCandidates() : Sequence(OclAny) =
    ARCHIMATE!ApplicationComponent.allInstances()->asSequence()
        ->collect(app |

            app.anchoredBehaviorPaths()->collect(p |

                thisModule.accesses()
                    ->select(r |
                        r.source = p.behavior and
                        r.target.oclIsKindOf(ARCHIMATE!DataObject)
                    )
                    ->collect(r |
                        Tuple {
                            app = app,
                            data = r.target,

                            evidenceBehavior = p.behavior,
                            evidenceRelation = r,

                            traceArtifacts =
                                p.path
                                    ->including(r)
                                    ->including(r.target),

                            key =
                                app.id +
                                '|accesses|' +
                                r.target.id
                        }
                    )
            )->flatten()
        )->flatten()
        ->asSequence();

-- APP-DER-03: Derive Application-Service usage through internal behavior
helper def : derivedServedByCandidates() : Sequence(OclAny) =
    ARCHIMATE!ApplicationComponent.allInstances()->asSequence()
        ->collect(app |

            app.anchoredBehaviorPaths()->collect(p |

                thisModule.servings()
                    ->select(r |
                        r.target = p.behavior and
                        r.source.oclIsKindOf(ARCHIMATE!ApplicationService)
                    )
                    ->collect(r |
                        Tuple {
                            app = app,
                            service = r.source,

                            evidenceBehavior = p.behavior,
                            evidenceRelation = r,

                            traceArtifacts =
                                p.path
                                    ->including(r)
                                    ->including(r.source),

                            key =
                                app.id +
                                '|servedBy|' +
                                r.source.id
                        }
                    )
            )->flatten()
        )->flatten()
        ->asSequence();

helper def : applicationServiceRealizationCandidates() : Sequence(OclAny) =
    thisModule.explicitComponentServiceRealizations()
        ->collect(r |
            Tuple {
                app = r.source,
                service = r.target,
                traceArtifacts = Sequence {
                    r.source,
                    r,
                    r.target
                },

                key =
                    r.source.id + '|realizesService|' + r.target.id
            }
        )
        ->union(thisModule.derivedRealizesServiceCandidates())
        ->asSequence();

-- APP-DER-04: Derive Application serving Business Process/Function via Application Service
helper def : derivedApplicationBusinessContextServingCandidates() : Sequence(OclAny) =
    thisModule.applicationServiceRealizationCandidates()
        ->collect(p |
            thisModule.explicitApplicationServiceProcessServings()
                ->union(thisModule.explicitApplicationServiceFunctionServings())
                ->select(r | r.source = p.service)
                ->collect(r |
                    Tuple {
                        app = p.app,
                        service = p.service,
                        businessContext = r.target,

                        evidenceServing = r,

                        traceArtifacts =
                            p.traceArtifacts
                                ->including(r)
                                ->including(r.target),

                        key = p.app.id + '|servesBusinessContext|' + r.target.id
                    }
                )
        )
        ->flatten()
        ->asSequence();

helper def : applicationBusinessContextServingCandidates() : Sequence(OclAny) =
    thisModule.explicitApplicationBusinessContextServings()
        ->collect(r |
            Tuple {
                app = r.source,
                businessContext = r.target,

                evidenceServing = r,

                traceArtifacts = Sequence {
                    r.source,
                    r,
                    r.target
                },

                key = r.source.id + '|servesBusinessContext|' + r.target.id
            }
        )

        ->union(
            thisModule.derivedApplicationBusinessContextServingCandidates()
        )

        ->asSequence();

-- APP-DER-05: Derive Application serving Actor/Role through served Business Process/Function
helper def : derivedApplicationOrganizationServingDirectCandidates() : Sequence(OclAny) =
    thisModule.applicationBusinessContextServingCandidates()
        ->collect(p |
            thisModule.explicitBusinessContextAssignments()
                ->select(r |
                    r.target = p.businessContext
                )
                ->collect(r |

                    Tuple {
                        app = p.app,

                        businessContext = p.businessContext,
                        organization = r.source,

                        evidenceServing = p.evidenceServing,
                        evidenceAssignment = r,

                        traceArtifacts =
                            p.traceArtifacts
                                ->including(r)
                                ->including(r.source),

                        key = p.app.id + '|servesOrganization|' + r.source.id
                    }
                )
        )
        ->flatten()
        ->asSequence();

helper def : derivedApplicationOrganizationServingCandidates() : Sequence(OclAny) =
    thisModule.derivedApplicationOrganizationServingDirectCandidates();

helper def : derivedTechnologyRealizationCandidates() : Sequence(OclAny) =
    thisModule.technologyAnchors()
        ->collect(tech |

            tech.technologyAnchoredBehaviorPaths()->collect(p |

                thisModule.realizations()
                    ->select(r |
                        r.source = p.behavior and
                        r.target.oclIsKindOf(ARCHIMATE!TechnologyService)
                    )
                    ->collect(r |
