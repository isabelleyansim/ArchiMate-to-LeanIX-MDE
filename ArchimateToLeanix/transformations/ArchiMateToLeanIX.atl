            r.source.oclIsKindOf(ARCHIMATE!Node) or
            r.source.oclIsKindOf(ARCHIMATE!Device) or
            r.source.oclIsKindOf(ARCHIMATE!SystemSoftware)
        ) and
        r.target.oclIsKindOf(ARCHIMATE!Artifact))->asSequence();

helper def : explicitTechnologyServiceRealizations() : Sequence(ARCHIMATE!RealizationRelationship) =
