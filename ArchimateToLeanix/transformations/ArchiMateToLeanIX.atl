        r.target.oclIsKindOf(ARCHIMATE!DataObject)
    )->asSequence();

-- ============================================================================
-- Application Flow restructuring
-- ============================================================================

helper context ARCHIMATE!FlowRelationship def : flowNameKey() : String =
	if self.name.oclIsUndefined() then
		''
	else
		self.name
	endif;

helper context ARCHIMATE!FlowRelationship def : sameDirectionSameNamedFlows() : Sequence (ARCHIMATE!FlowRelationship) = 
	thisModule.applicationComponentFlows()->select(r |
		r.source = self.source and
		r.target = self.target and
		r.flowNameKey() = self.flowNameKey())->asSequence();

helper context ARCHIMATE!FlowRelationship def : matchingReverseFlows() : Sequence (ARCHIMATE!FlowRelationship) = 
	thisModule.applicationComponentFlows()->select(r |
		r.source = self.target and
		r.target = self.source and
		r.flowNameKey() = self.flowNameKey())->asSequence();

helper context ARCHIMATE!FlowRelationship def : formsSimpleBidirectionalPair() : Boolean =
	self.sameDirectionSameNamedFlows()->size() = 1 and
	self.matchingReverseFlows()->size() = 1;

helper context ARCHIMATE!FlowRelationship def : isRepresentativeApplicationFlow() : Boolean =
	if self.formsSimpleBidirectionalPair() then
		Sequence{self}
			->union(self.matchingReverseFlows())
			->sortedBy(r | r.id)
			->first() = self
	else
		true
	endif;

helper context ARCHIMATE!FlowRelationship def : flowEvidence() : Sequence(ARCHIMATE!FlowRelationship) =
	if self.formsSimpleBidirectionalPair() then
		Sequence{self}
			->union(self.matchingReverseFlows())
			->asSequence()
	else
		Sequence{self}
	endif;
	
helper def : restructuredApplicationFlows() : Sequence(ARCHIMATE!FlowRelationship) =
	thisModule.applicationComponentFlows()->select(r |
		r.isRepresentativeApplicationFlow())->asSequence();

helper context ARCHIMATE!FlowRelationship def : logicalInterfaceBaseName() : String =
	if self.name.oclIsUndefined() or self.name = '' then
		self.source.safeName() + ' - ' + self.target.safeName()
	else
		self.source.safeName() + ' - ' + self.target.safeName() + ' Flow - ' + self.name
	endif;

helper context ARCHIMATE!FlowRelationship def : logicalInterfaceName() : String =
	let sameNames : Sequence(ARCHIMATE!FlowRelationship) =
		thisModule.restructuredApplicationFlows()
		->select(r | r.logicalInterfaceBaseName() = self.logicalInterfaceBaseName())
		->sortedBy(r | r.id)
	in
	if sameNames->size() <= 1 then
		self.logicalInterfaceBaseName()
	else
		if sameNames->first() = self then
			self.logicalInterfaceBaseName()
		else
			self.logicalInterfaceBaseName() + ' ' + sameNames->indexOf(self).toString()
		endif
	endif;

-- ============================================================================
-- Explicit relationship checks
-- ============================================================================
	
helper context ARCHIMATE!ApplicationComponent def : explicitServiceRealization(
	s : ARCHIMATE!ApplicationService) : ARCHIMATE!RealizationRelationship =
    thisModule.explicitComponentServiceRealizations()
        ->select(r |
            r.source = self and
            r.target = s
        )
        ->first();

helper context ARCHIMATE!ApplicationComponent def : explicitDataAccess(
	d : ARCHIMATE!DataObject) : ARCHIMATE!AccessRelationship =
    thisModule.explicitComponentDataAccesses()
        ->select(r |
            r.source = self and
            r.target = d
        )
        ->first();

helper context ARCHIMATE!ApplicationComponent def : explicitServiceServing(
	s : ARCHIMATE!ApplicationService) : ARCHIMATE!ServingRelationship =
    thisModule.explicitServiceComponentServings()
        ->select(r |
            r.source = s and
            r.target = self
        )
        ->first();

helper context ARCHIMATE!ArchimateElement def : explicitTechnologyServiceRealization(
	s : ARCHIMATE!TechnologyService) : ARCHIMATE!RealizationRelationship =
    thisModule.explicitTechnologyServiceRealizations()
        ->select(r |
            r.source = self and
            r.target = s
        )
        ->first();

helper context ARCHIMATE!ArchimateElement def : explicitArtifactAccess(
	a : ARCHIMATE!Artifact) : ARCHIMATE!AccessRelationship =
    thisModule.explicitTechnologyArtifactAccesses()
        ->select(r |
            r.source = self and
            r.target = a
        )
        ->first();


helper context ARCHIMATE!ArchimateElement def : explicitTechnologyServiceServing(
	s : ARCHIMATE!TechnologyService) : ARCHIMATE!ServingRelationship =
    thisModule.explicitTechnologyServiceAnchorServings()
        ->select(r |
            r.source = s and
            r.target = self
        )
        ->first();

helper context ARCHIMATE!ApplicationComponent def : explicitlyRealizesService(
    s : ARCHIMATE!ApplicationService
) : Boolean =
    thisModule.realizations()->exists(r | r.source = self and r.target = s);

helper context ARCHIMATE!ApplicationComponent def : explicitlyAccessesData(
    d : ARCHIMATE!DataObject
) : Boolean =
    thisModule.accesses()->exists(r | r.source = self and r.target = d);

helper context ARCHIMATE!ApplicationComponent def : explicitlyServedByService(
    s : ARCHIMATE!ApplicationService
) : Boolean =
    thisModule.servings()->exists(r | r.source = s and r.target = self);

helper context ARCHIMATE!ApplicationComponent def : explicitlyRealizesCapability(
    c : ARCHIMATE!Capability
) : Boolean =
    thisModule.realizations()->exists(r | r.source = self and r.target = c);

helper context ARCHIMATE!ApplicationComponent def : explicitCapabilityRealization(c : ARCHIMATE!Capability) : ARCHIMATE!RealizationRelationship =
    thisModule.explicitComponentCapabilityRealizations()
        ->select(r |
            r.source = self and
            r.target = c
        )
        ->first();

helper context ARCHIMATE!ArchimateElement def : explicitlyRealizesTechnologyService(
    s : ARCHIMATE!TechnologyService
) : Boolean =
    thisModule.realizations()->exists(r | r.source = self and r.target = s);

helper context ARCHIMATE!ArchimateElement def : explicitlyAccessesArtifact(
    a : ARCHIMATE!Artifact
) : Boolean =
	thisModule.accesses()->exists(r | r.source = self and r.target = a);

helper context ARCHIMATE!ArchimateElement def : explicitlyServedByTechnologyService(
    s : ARCHIMATE!TechnologyService
) : Boolean =
    thisModule.servings()->exists(r | r.source = s and r.target = self);

helper context ARCHIMATE!ArchimateElement def : explicitlyServesApplication(
    a : ARCHIMATE!ApplicationComponent
) : Boolean =
    thisModule.explicitTechnologyApplicationServings()->exists(r | r.source = self and r.target = a);

helper context ARCHIMATE!ArchimateElement def : explicitApplicationServing(
    a : ARCHIMATE!ApplicationComponent
) : ARCHIMATE!ServingRelationship =
    thisModule.explicitTechnologyApplicationServings()
        ->select(r | r.source = self and r.target = a)
        ->first();

helper context ARCHIMATE!ApplicationComponent def : explicitlyServesBusinessContext(
    b : ARCHIMATE!ArchimateElement
) : Boolean =
    thisModule.explicitApplicationBusinessContextServings()
        ->exists(r | r.source = self and r.target = b);

helper context ARCHIMATE!ApplicationComponent def : explicitBusinessContextServing(
    b : ARCHIMATE!ArchimateElement
) : ARCHIMATE!ServingRelationship =
    thisModule.explicitApplicationBusinessContextServings()
        ->select(r | r.source = self and r.target = b)
        ->first();


helper context ARCHIMATE!ApplicationComponent def : explicitlyServesOrganization(
    o : ARCHIMATE!ArchimateElement
) : Boolean =
    thisModule.explicitApplicationOrganizationServings()
        ->exists(r | r.source = self and r.target = o);

helper context ARCHIMATE!ApplicationComponent def : explicitOrganizationServing(
	o : ARCHIMATE!ArchimateElement
) : ARCHIMATE!ServingRelationship =
    thisModule.explicitApplicationOrganizationServings()
        ->select(r | r.source = self and r.target = o)
        ->first();

-- ============================================================================
-- Mapping rule ID selection
-- ============================================================================
helper context ARCHIMATE!AssignmentRelationship def : businessContextAssignmentRuleId() : String =
    if self.source.oclIsKindOf(ARCHIMATE!BusinessActor) and
       self.target.oclIsKindOf(ARCHIMATE!BusinessProcess) then
        'REL-B-02'

    else if self.source.oclIsKindOf(ARCHIMATE!BusinessRole) and
            self.target.oclIsKindOf(ARCHIMATE!BusinessProcess) then
        'REL-B-03'

    else if self.source.oclIsKindOf(ARCHIMATE!BusinessActor) and
            self.target.oclIsKindOf(ARCHIMATE!BusinessFunction) then
        'REL-B-04'

    else
        'REL-B-05'
    endif endif endif;

