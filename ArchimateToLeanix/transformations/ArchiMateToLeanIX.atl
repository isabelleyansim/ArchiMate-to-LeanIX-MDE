        r.source.oclIsKindOf(ARCHIMATE!TechnologyInterface) and (
	        r.target.oclIsKindOf(ARCHIMATE!Node) or
	        r.target.oclIsKindOf(ARCHIMATE!Device) or
	        r.target.oclIsKindOf(ARCHIMATE!SystemSoftware)))->asSequence();

helper def : explicitTechnologyInterfaceServiceAssignments() : Sequence(ARCHIMATE!AssignmentRelationship) =
    thisModule.assignments()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!TechnologyInterface) and
        r.target.oclIsKindOf(ARCHIMATE!TechnologyService))->asSequence();

