helper def : technologyServiceRealizationCandidates() : Sequence(OclAny) =
    thisModule.explicitTechnologyServiceRealizations()
        ->collect(r |
            Tuple {
                tech = r.source,
                service = r.target,
                traceArtifacts = Sequence {
                    r.source,
                    r,
                    r.target
                },

                key =
                    r.source.id + '|realizesTechnologyService|' + r.target.id
            }
        )
        ->union(
            thisModule.derivedTechnologyRealizationCandidates()
        )
        ->asSequence();


-- TEC-DER-04: Derive IT Component serving Application through Technology Service
helper def : derivedTechnologyApplicationServingCandidates() : Sequence(OclAny) =
    thisModule.technologyServiceRealizationCandidates()
        ->collect(p |
            thisModule.explicitTechnologyServiceApplicationServings()
                ->select(r | r.source = p.service)
                ->collect(r |
                    Tuple {
                        tech = p.tech,
                        service = p.service,
                        app = r.target,

                        evidenceServing = r,

                        traceArtifacts =
                            p.traceArtifacts
                                ->including(r)
                                ->including(r.target),

                        key =
                            p.tech.id + '|servesApplication|' + r.target.id
                    }
                )
        )
        ->flatten()
        ->asSequence();

