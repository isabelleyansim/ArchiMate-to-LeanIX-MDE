helper def : uniqueDerivedRealizesServiceCandidates : Sequence(OclAny) =
    thisModule.derivedRealizesServiceCandidates()
        ->select(c | thisModule.derivedRealizesServiceCandidates()
            ->select(x | x.key = c.key)->first() = c)
        ->asSequence();

helper def : uniqueDerivedAccessCandidates : Sequence(OclAny) =
    thisModule.derivedAccessCandidates()
        ->select(c | thisModule.derivedAccessCandidates()
            ->select(x | x.key = c.key)->first() = c)
        ->asSequence();

