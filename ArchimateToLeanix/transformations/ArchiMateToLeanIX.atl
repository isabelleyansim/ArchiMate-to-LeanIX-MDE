-- ============================================================================
-- Application capability derivation candidates
-- ============================================================================
	
-- APP-CAP-DER-01: Capability support through assigned application behavior
helper def : behaviorMediatedCapabilityCandidates() : Sequence(OclAny) =
    ARCHIMATE!ApplicationComponent.allInstances()->asSequence()
	    ->collect(app | app.directlyAssignedBehaviorSteps()
            ->collect(step |
                thisModule.realizations()
                    ->select(r |
                        r.source = step.behavior and
                        r.target.oclIsKindOf(ARCHIMATE!Capability))
                    ->collect(r |
                        Tuple {
	                        app = app,
	                        capability = r.target,
	
	                        ruleId = 'APP-CAP-DER-01',
	
	                        evidenceRelation = r,
	
	                        traceArtifacts = Sequence {
	                            app,
	                            step.relation,
	                            step.behavior,
	                            r,
	                            r.target },
	
	                        key = app.id + '|supports|' + r.target.id
                        }
                    )
            )->flatten()
	    )->flatten()
	    ->asSequence();

-- APP-CAP-DER-02: Capability support through Resource
helper def : resourceMediatedCapabilityCandidates() : Sequence(OclAny) =
    ARCHIMATE!ApplicationComponent.allInstances()->asSequence()
        ->collect(app |
            thisModule.realizations()
                ->select(r1 |
                    r1.source = app and
                    r1.target.oclIsKindOf(ARCHIMATE!Resource))
                ->collect(r1 |
                    thisModule.assignments()
                        ->select(r2 |
                            r2.source = r1.target and
                            r2.target.oclIsKindOf(ARCHIMATE!Capability))
                        ->collect(r2 |
                            Tuple {
                                app = app,
                                capability = r2.target,

                                ruleId = 'APP-CAP-DER-02',

                                evidenceRelation = r2,

                                traceArtifacts = Sequence {
                                    app,
                                    r1,
                                    r1.target,
                                    r2,
                                    r2.target},

                                key = app.id + '|supports|' + r2.target.id
                            }
                        )
                )->flatten()
        )->flatten()
        ->asSequence();

-- APP-CAP-DER-03: Capability support through explicit Application Service realization
helper def : serviceMediatedCapabilityCandidates() : Sequence(OclAny) =
    ARCHIMATE!ApplicationComponent.allInstances()->asSequence()
        ->collect(app |
            thisModule.realizations()
                ->select(r1 |
                    r1.source = app and
                    r1.target.oclIsKindOf(ARCHIMATE!ApplicationService))
                ->collect(r1 |
                    thisModule.realizations()
                        ->select(r2 |
                            r2.source = r1.target and
                            r2.target.oclIsKindOf(ARCHIMATE!Capability))
                        ->collect(r2 |
                            Tuple {
                                app = app,
                                capability = r2.target,

                                ruleId = 'APP-CAP-DER-03',

                                evidenceRelation = r2,

                                traceArtifacts = Sequence {
                                    app,
                                    r1,
                                    r1.target,
                                    r2,
                                    r2.target},

                                key = app.id + '|supports|' + r2.target.id
                            }
                        )
                )->flatten()
        )->flatten()
        ->asSequence();

-- APP-CAP-DER-04: Capability support through derived Application Service realization
helper def : derivedServiceMediatedCapabilityCandidates() : Sequence(OclAny) =
    thisModule.derivedRealizesServiceCandidates()
        ->collect(p |
            thisModule.realizations()
                ->select(r |
                    r.source = p.service and
                    r.target.oclIsKindOf(ARCHIMATE!Capability)
                )
                ->collect(r |
                    Tuple {
                        app = p.app,
                        capability = r.target,

                        ruleId = 'APP-CAP-DER-04',

                        evidenceRelation = r,

                        traceArtifacts =
                            p.traceArtifacts
                                ->including(r)
                                ->including(r.target),

                        key = p.app.id + '|supports|' + r.target.id
                    }
                )
        )
        ->flatten()
        ->asSequence();

helper def : applicationCapabilityCandidates() : Sequence(OclAny) =
	thisModule.behaviorMediatedCapabilityCandidates()
		->union(
			thisModule.resourceMediatedCapabilityCandidates()
		)
		->union(
			thisModule.serviceMediatedCapabilityCandidates()	
		)
        ->union(
            thisModule.derivedServiceMediatedCapabilityCandidates()
        )		
		->asSequence();

helper def : uniqueApplicationCapabilityCandidates : Sequence(OclAny) =
	thisModule.applicationCapabilityCandidates()
		->select(c |
			thisModule.applicationCapabilityCandidates()
				->select(x | x.key = c.key)
				->first() = c
		)
		->asSequence();

helper def : canonicalApplicationCapabilityCandidate(c : OclAny) : OclAny =
    thisModule.applicationCapabilityCandidates()
        ->select(x | x.key = c.key)
        ->first();

-- ============================================================================
-- Trace path identifiers
-- ============================================================================

helper def : derivedTracePathKey(c : OclAny) : String =
    c.traceArtifacts
        ->iterate(
            a;
            acc : String = '' | acc + '-' + a.id
        );

-- ============================================================================
-- Root model generation
-- ============================================================================

entrypoint rule CreateLeanIXModelRoot() {
    to
        out : LEANIX!LeanIXModel (

            factSheets <-
                Sequence{}
            		->union(
			            ARCHIMATE!Goal.allInstances()->asSequence()
			                ->collect(e | thisModule.Goal2Objective(e))
			        )
            
            		->union(
					    ARCHIMATE!Capability.allInstances()->asSequence()
					        ->collect(c | thisModule.Capability2BusinessCapability(c))
					)
					->union(
			            ARCHIMATE!WorkPackage.allInstances()->asSequence()
			                ->collect(e | thisModule.WorkPackage2Initiative(e))
			        )	
                    ->union(
                        ARCHIMATE!ApplicationComponent.allInstances()->asSequence()
                            ->collect(e | thisModule.ApplicationComponent2Application(e))
                    )
                    ->union(
                        ARCHIMATE!ApplicationService.allInstances()->asSequence()
                            ->collect(e | thisModule.ApplicationService2CustomService(e))
                    )
                    ->union(
                        ARCHIMATE!ApplicationInterface.allInstances()->asSequence()
                            ->collect(e | thisModule.ApplicationInterface2Interface(e))
                    )
					->union(
					    thisModule.restructuredApplicationFlows()
					        ->collect(r | thisModule.CreateLogicalInterfaceFromFlow(r))
					)
                    ->union(
                        ARCHIMATE!DataObject.allInstances()->asSequence()
                            ->collect(e | thisModule.DataObject2DataObject(e))
                    )				
					->union(
						ARCHIMATE!BusinessProcess.allInstances()->asSequence()
                            ->collect(e | thisModule.BusinessProcess2BusinessContext(e))	
					)
					->union(
						ARCHIMATE!BusinessFunction.allInstances()->asSequence()
                            ->collect(e | thisModule.BusinessFunction2BusinessContext(e))	
					)
					->union(
						ARCHIMATE!BusinessActor.allInstances()->asSequence()
                            ->collect(e | thisModule.BusinessActor2Organization(e))	
					)
					->union(
						ARCHIMATE!BusinessRole.allInstances()->asSequence()
                            ->collect(e | thisModule.BusinessRole2Organization(e))	
					)
					->union(
						ARCHIMATE!BusinessService.allInstances()->asSequence()
                            ->collect(e | thisModule.BusinessService2CustomService(e))	
					)
					->union(
						ARCHIMATE!BusinessObject.allInstances()->asSequence()
                            ->collect(e | thisModule.BusinessObject2DataObject(e))	
					)
					->union(
						ARCHIMATE!Product.allInstances()->asSequence()
                            ->collect(e | thisModule.Product2BusinessContext(e))	
					)
					->union(
					    ARCHIMATE!Node.allInstances()->asSequence()
					        ->collect(e | thisModule.Node2ITComponent(e))
					)
					->union(
					    ARCHIMATE!Device.allInstances()->asSequence()
					        ->collect(e | thisModule.Device2ITComponent(e))
					)
					->union(
					    ARCHIMATE!SystemSoftware.allInstances()->asSequence()
					        ->collect(e | thisModule.SystemSoftware2ITComponent(e))
					)
					->union(
					    ARCHIMATE!TechnologyService.allInstances()->asSequence()
					        ->collect(e | thisModule.TechnologyService2CustomService(e))
					)
					->union(
					    ARCHIMATE!TechnologyInterface.allInstances()->asSequence()
					        ->collect(e | thisModule.TechnologyInterface2Interface(e))
					)
					->union(
					    ARCHIMATE!Artifact.allInstances()->asSequence()
					        ->collect(e | thisModule.Artifact2DataObject(e))
					)
                    ->flatten()
                    ->asSequence(),

            relations <-
                Sequence{}                    
					->union(
					    thisModule.explicitSameTypeCompositions()
					        ->collect(r | thisModule.CreateSameTypeCompositionRelation(r))
					)
					->union(
					    thisModule.explicitSameTypeAggregations()
					        ->collect(r | thisModule.CreateSameTypeAggregationRelation(r))
					)
					->union(
					    thisModule.explicitSameTypeSpecializations()
					        ->collect(r | thisModule.CreateSameTypeSpecializationRelation(r))
					)
                    ->union(
                        thisModule.explicitComponentServiceRealizations()
                            ->collect(r | thisModule.CreateExplicitRealizesServiceRelation(r))
                    )
                    ->union(
                        thisModule.explicitServiceComponentServings()
                            ->collect(r | thisModule.CreateExplicitServedByRelation(r))
                    )
                    ->union(
                        thisModule.explicitComponentInterfaceCompositions()
                            ->collect(r | thisModule.CreateApplicationInterfaceComposition(r))
                    )
					->union(
                        thisModule.explicitInterfaceComponentServings()
                            ->collect(r | thisModule.CreateApplicationInterfaceServing(r))
                    )
                    ->union(
                        thisModule.explicitInterfaceServiceAssignments()
                            ->collect(r | thisModule.CreateInterfaceServiceAssignment(r))
                    )
					->union(
					    thisModule.restructuredApplicationFlows()
					        ->collect(r | thisModule.CreateFlowProvidesInterface(r))
					)
					->union(
					    thisModule.restructuredApplicationFlows()
					        ->collect(r | thisModule.CreateFlowConsumesInterface(r))
					)
                    ->union(
                        thisModule.explicitServiceDataAccesses()
                            ->collect(r | thisModule.CreateServiceDataAccess(r))
                    )
                    ->union(
                        thisModule.explicitComponentDataAccesses()
                            ->collect(r | thisModule.CreateExplicitApplicationDataAccess(r))
                    )
					->union(
					    thisModule.explicitComponentCapabilityRealizations()
					        ->collect(r | thisModule.CreateExplicitApplicationCapabilitySupport(r))
					)
					->union(
					    thisModule.explicitActorRoleAssignments()
					        ->collect(r | thisModule.CreateActorRoleAssignment(r))
					)
					->union(
					    thisModule.explicitBusinessContextAssignments()
					        ->collect(r | thisModule.CreateBusinessContextAssignment(r))
					)
					->union(
					    thisModule.explicitProcessServiceRealizations()
					        ->collect(r | thisModule.CreateProcessServiceRealization(r))
					)
					->union(
					    thisModule.explicitFunctionServiceRealizations()
					        ->collect(r | thisModule.CreateFunctionServiceRealization(r))
					)
					->union(
					    thisModule.explicitProcessBusinessObjectAccesses()
					        ->collect(r | thisModule.CreateProcessBusinessObjectAccess(r))
					)
					->union(
					    thisModule.explicitFunctionBusinessObjectAccesses()
					        ->collect(r | thisModule.CreateFunctionBusinessObjectAccess(r))
					)
					->union(
					    thisModule.explicitBusinessServiceOrganizationServings()
					        ->collect(r | thisModule.CreateBusinessServiceOrganizationServing(r))
					)
					->union(
					    thisModule.explicitBusinessServiceBusinessObjectAccesses()
					        ->collect(r | thisModule.CreateBusinessServiceBusinessObjectAccess(r))
					)
					->union(
					    thisModule.explicitApplicationServiceProcessServings()
					        ->collect(r | thisModule.CreateApplicationServiceProcessServing(r))
					)
					->union(
					    thisModule.explicitApplicationServiceFunctionServings()
					        ->collect(r | thisModule.CreateApplicationServiceFunctionServing(r))
					)
					->union(
					    thisModule.explicitApplicationBusinessContextServings()
					        ->collect(r | thisModule.CreateApplicationBusinessContextServing(r))
					)
					->union(
					    thisModule.explicitApplicationOrganizationServings()
					        ->collect(r | thisModule.CreateApplicationOrganizationServing(r))
					)
					->union(
					    thisModule.explicitDataObjectBusinessObjectRealizations()
					        ->collect(r | thisModule.CreateDataObjectBusinessObjectRealization(r))
					)					
					->union(
					    thisModule.explicitTechnologyContainmentCompositions()
					        ->collect(r | thisModule.CreateTechnologyContainmentComposition(r))
					)
					->union(
					    thisModule.explicitTechnologyContainmentAggregations()
					        ->collect(r | thisModule.CreateTechnologyContainmentAggregation(r))
					)
					->union(
					    thisModule.explicitTechnologyHostAssignments()
					        ->collect(r | thisModule.CreateTechnologyHostAssignment(r))
					)
					->union(
					    thisModule.explicitTechnologyInterfaceCompositions()
					        ->collect(r | thisModule.CreateTechnologyInterfaceComposition(r))
					)
					->union(
					    thisModule.explicitTechnologyInterfaceServings()
					        ->collect(r | thisModule.CreateTechnologyInterfaceServing(r))
					)
					->union(
					    thisModule.explicitTechnologyInterfaceServiceAssignments()
					        ->collect(r | thisModule.CreateTechnologyInterfaceServiceAssignment(r))
					)
					->union(
					    thisModule.explicitTechnologyArtifactDeployments()
					        ->collect(r | thisModule.CreateTechnologyArtifactDeployment(r))
					)
					->union(
					    thisModule.explicitTechnologyServiceArtifactAccesses()
					        ->collect(r | thisModule.CreateTechnologyServiceArtifactAccess(r))
					)
					->union(
					    thisModule.explicitTechnologyArtifactAccesses()
					        ->collect(r | thisModule.CreateTechnologyArtifactAccess(r))
					)
					->union(
					    thisModule.explicitTechnologyServiceApplicationServings()
					        ->collect(r | thisModule.CreateTechnologyServiceApplicationServing(r))
					)
					->union(
					    thisModule.explicitTechnologyServiceAnchorServings()
					        ->collect(r | thisModule.CreateTechnologyServiceAnchorServing(r))
					)
					->union(
					    thisModule.explicitTechnologyServiceRealizations()
					        ->collect(r | thisModule.CreateTechnologyServiceRealization(r))
					)
					->union(
					    thisModule.explicitTechnologyApplicationServings()
					        ->collect(r | thisModule.CreateTechnologyApplicationServing(r))
					)
					->union(
					    thisModule.explicitArtifactDataObjectRealizations()
					        ->collect(r | thisModule.CreateArtifactDataObjectRealization(r))
					)
                    ->union(
                        thisModule.uniqueDerivedRealizesServiceCandidates
                            ->reject(c | c.app.explicitlyRealizesService(c.service))
                            ->collect(c | thisModule.CreateDerivedRealizesServiceRelation(c))
                    )
                    ->union(
                        thisModule.uniqueDerivedAccessCandidates
                            ->reject(c | c.app.explicitlyAccessesData(c.data))
                            ->collect(c | thisModule.CreateDerivedApplicationDataAccess(c))
                    )
                    ->union(
                        thisModule.uniqueDerivedServedByCandidates
                            ->reject(c | c.app.explicitlyServedByService(c.service))
                            ->collect(c | thisModule.CreateDerivedServedByRelation(c))
                    )
					->union(
					    thisModule.uniqueDerivedTechnologyRealizationCandidates
					        ->reject(c | c.tech.explicitlyRealizesTechnologyService(c.service))
					        ->collect(c | thisModule.CreateDerivedTechnologyServiceRealization(c))
					)
					->union(
					    thisModule.uniqueDerivedTechnologyAccessCandidates
					        ->reject(c | c.tech.explicitlyAccessesArtifact(c.artifact))
					        ->collect(c | thisModule.CreateDerivedTechnologyArtifactAccess(c))
					)
					->union(
					    thisModule.uniqueDerivedTechnologyServedByCandidates
					        ->reject(c | c.tech.explicitlyServedByTechnologyService(c.service))
					        ->collect(c | thisModule.CreateDerivedTechnologyServedBy(c))
					)
					->union(
					    thisModule.uniqueDerivedTechnologyApplicationServingCandidates
							->reject(c | c.tech.explicitlyServesApplication(c.app))
					        ->collect(c | thisModule.CreateDerivedTechnologyApplicationServing(c))
					)
					->union(
					    thisModule.uniqueDerivedApplicationBusinessContextServingCandidates
							->reject(c | c.app.explicitlyServesBusinessContext(c.businessContext))
					        ->collect(c | thisModule.CreateDerivedApplicationBusinessContextServing(c))
					)					
					->union(
					    thisModule.uniqueDerivedApplicationOrganizationServingCandidates
							    ->reject(c | c.app.explicitlyServesOrganization(c.organization))
					        ->collect(c | thisModule.CreateDerivedApplicationOrganizationServing(c))
					)
					->union(
					    thisModule.uniqueApplicationCapabilityCandidates
							->reject(c | c.app.explicitlyRealizesCapability(c.capability))
					        ->collect(c |thisModule.CreateDerivedApplicationCapabilitySupport(c))
					)
					
                    ->flatten()
                    ->asSequence()
        ),
		
		traceRoot : TRACE!TraceModel (
			traces <-
				Sequence{}
			        ->union(
			            ARCHIMATE!Goal.allInstances()->asSequence()
			                ->collect(e | thisModule.TraceGoal(e))
			        )
					->union(
					    ARCHIMATE!Capability.allInstances()->asSequence()
					        ->collect(c | thisModule.TraceCapability(c))
					)
					->union(
			            ARCHIMATE!WorkPackage.allInstances()->asSequence()
			                ->collect(e | thisModule.TraceWorkPackage(e))
			        )					
					->union(
						ARCHIMATE!ApplicationComponent.allInstances()
							->asSequence()
							->collect(e | thisModule.TraceApplicationComponent(e))
					)
					->union(
						ARCHIMATE!ApplicationService.allInstances()
							->asSequence()
							->collect(e | thisModule.TraceApplicationService(e))
					)
					->union(
						ARCHIMATE!ApplicationInterface.allInstances()
							->asSequence()
							->collect(e | thisModule.TraceApplicationInterface(e))
					)
					->union(
					    thisModule.restructuredApplicationFlows()
					        ->collect(r | thisModule.TraceLogicalInterfaceFromFlow(r))
					)
					->union(
						ARCHIMATE!DataObject.allInstances()
							->asSequence()
							->collect(e | thisModule.TraceDataObject(e))
					)					
					->union(
					    ARCHIMATE!BusinessProcess.allInstances()
					        ->asSequence()
					        ->collect(e | thisModule.TraceBusinessProcess(e))
					)
					->union(
					    ARCHIMATE!BusinessFunction.allInstances()
					        ->asSequence()
					        ->collect(e | thisModule.TraceBusinessFunction(e))
					)
					->union(
					    ARCHIMATE!BusinessActor.allInstances()
					        ->asSequence()
					        ->collect(e | thisModule.TraceBusinessActor(e))
					)
					->union(
					    ARCHIMATE!BusinessRole.allInstances()
					        ->asSequence()
					        ->collect(e | thisModule.TraceBusinessRole(e))
					)
					->union(
					    ARCHIMATE!BusinessService.allInstances()
					        ->asSequence()
					        ->collect(e | thisModule.TraceBusinessService(e))
					)
					->union(
					    ARCHIMATE!BusinessObject.allInstances()
					        ->asSequence()
					        ->collect(e | thisModule.TraceBusinessObject(e))
					)
					->union(
					    ARCHIMATE!Product.allInstances()
					        ->asSequence()
					        ->collect(e | thisModule.TraceProduct(e))
					)
					->union(
					    ARCHIMATE!Node.allInstances()->asSequence()
					        ->collect(e | thisModule.TraceNode(e))
					)
					->union(
					    ARCHIMATE!Device.allInstances()->asSequence()
					        ->collect(e | thisModule.TraceDevice(e))
					)
					->union(
					    ARCHIMATE!SystemSoftware.allInstances()->asSequence()
					        ->collect(e | thisModule.TraceSystemSoftware(e))
					)
					->union(
					    ARCHIMATE!TechnologyService.allInstances()->asSequence()
					        ->collect(e | thisModule.TraceTechnologyService(e))
					)
					->union(
					    ARCHIMATE!TechnologyInterface.allInstances()->asSequence()
					        ->collect(e | thisModule.TraceTechnologyInterface(e))
					)
					->union(
					    ARCHIMATE!Artifact.allInstances()->asSequence()
					        ->collect(e | thisModule.TraceArtifact(e))
					)
					->union(
					    thisModule.explicitSameTypeCompositions()
					        ->collect(r | thisModule.TraceSameTypeComposition(r))
					)
					->union(
					    thisModule.explicitSameTypeAggregations()
					        ->collect(r | thisModule.TraceSameTypeAggregation(r))
					)
					->union(
					    thisModule.explicitSameTypeSpecializations()
					        ->collect(r | thisModule.TraceSameTypeSpecialization(r))
					)
					->union(
						thisModule.explicitComponentServiceRealizations()
							->collect(r | thisModule.TraceExplicitRealizesService(r))
					)
					->union(
						thisModule.explicitServiceComponentServings()
							->collect(r | thisModule.TraceExplicitServedBy(r))
					)
					->union(
					    thisModule.explicitComponentInterfaceCompositions()
					        ->collect(r | thisModule.TraceApplicationInterfaceComposition(r))
					)
					->union(
                        thisModule.explicitInterfaceComponentServings()
                            ->collect(r | thisModule.TraceApplicationInterfaceServing(r))
                    )
					->union(
					    thisModule.explicitInterfaceServiceAssignments()
					        ->collect(r | thisModule.TraceInterfaceServiceAssignment(r))
					)
					->union(
					    thisModule.restructuredApplicationFlows()
					        ->collect(r | thisModule.TraceFlowProvidesInterface(r))
					)
					->union(
					    thisModule.restructuredApplicationFlows()
					        ->collect(r | thisModule.TraceFlowConsumesInterface(r))
					)
					->union(
					    thisModule.explicitServiceDataAccesses()
					        ->collect(r | thisModule.TraceServiceDataAccess(r))
					)
					->union(
					    thisModule.explicitComponentDataAccesses()
					        ->collect(r | thisModule.TraceExplicitApplicationDataAccess(r))
					)
					->union(
					    thisModule.explicitComponentCapabilityRealizations()
					        ->collect(r | thisModule.TraceExplicitApplicationCapabilitySupport(r))
					)
					->union(
					    thisModule.explicitActorRoleAssignments()
					        ->collect(r | thisModule.TraceActorRoleAssignment(r))
					)
					->union(
					    thisModule.explicitBusinessContextAssignments()
					        ->collect(r | thisModule.TraceBusinessContextAssignment(r))
					)
					->union(
					    thisModule.explicitProcessServiceRealizations()
					        ->collect(r | thisModule.TraceProcessServiceRealization(r))
					)
					->union(
					    thisModule.explicitFunctionServiceRealizations()
					        ->collect(r | thisModule.TraceFunctionServiceRealization(r))
					)
					->union(
					    thisModule.explicitProcessBusinessObjectAccesses()
					        ->collect(r | thisModule.TraceProcessBusinessObjectAccess(r))
					)
					->union(
					    thisModule.explicitFunctionBusinessObjectAccesses()
					        ->collect(r | thisModule.TraceFunctionBusinessObjectAccess(r))
					)
					->union(
					    thisModule.explicitBusinessServiceOrganizationServings()
					        ->collect(r | thisModule.TraceBusinessServiceOrganizationServing(r))
					)
					->union(
					    thisModule.explicitBusinessServiceBusinessObjectAccesses()
					        ->collect(r | thisModule.TraceBusinessServiceBusinessObjectAccess(r))
					)
					->union(
					    thisModule.explicitApplicationServiceProcessServings()
					        ->collect(r | thisModule.TraceApplicationServiceProcessServing(r))
					)
					->union(
					    thisModule.explicitApplicationServiceFunctionServings()
					        ->collect(r | thisModule.TraceApplicationServiceFunctionServing(r))
					)
					->union(
					    thisModule.explicitApplicationBusinessContextServings()
					        ->collect(r | thisModule.TraceApplicationBusinessContextServing(r))
					)
					->union(
					    thisModule.explicitApplicationOrganizationServings()
					        ->collect(r | thisModule.TraceApplicationOrganizationServing(r))
					)
					->union(
					    thisModule.explicitDataObjectBusinessObjectRealizations()
					        ->collect(r | thisModule.TraceDataObjectBusinessObjectRealization(r))
					)
					->union(
					    thisModule.explicitTechnologyContainmentCompositions()
					        ->collect(r | thisModule.TraceTechnologyContainmentComposition(r))
					)
					->union(
					    thisModule.explicitTechnologyContainmentAggregations()
					        ->collect(r | thisModule.TraceTechnologyContainmentAggregation(r))
					)
					->union(
					    thisModule.explicitTechnologyHostAssignments()
					        ->collect(r | thisModule.TraceTechnologyHostAssignment(r))
					)
					->union(
					    thisModule.explicitTechnologyInterfaceCompositions()
					        ->collect(r | thisModule.TraceTechnologyInterfaceComposition(r))
					)
					->union(
					    thisModule.explicitTechnologyInterfaceServings()
					        ->collect(r | thisModule.TraceTechnologyInterfaceServing(r))
					)
					->union(
					    thisModule.explicitTechnologyInterfaceServiceAssignments()
					        ->collect(r | thisModule.TraceTechnologyInterfaceServiceAssignment(r))
					)
					->union(
					    thisModule.explicitTechnologyArtifactDeployments()
					        ->collect(r | thisModule.TraceTechnologyArtifactDeployment(r))
					)
					->union(
					    thisModule.explicitTechnologyServiceArtifactAccesses()
					        ->collect(r | thisModule.TraceTechnologyServiceArtifactAccess(r))
					)
					->union(
					    thisModule.explicitTechnologyArtifactAccesses()
					        ->collect(r | thisModule.TraceTechnologyArtifactAccess(r))
					)
					->union(
					    thisModule.explicitTechnologyServiceApplicationServings()
					        ->collect(r | thisModule.TraceTechnologyServiceApplicationServing(r))
					)
					->union(
					    thisModule.explicitTechnologyApplicationServings()
					        ->collect(r | thisModule.TraceTechnologyApplicationServing(r))
					)
					->union(
					    thisModule.explicitTechnologyServiceAnchorServings()
					        ->collect(r | thisModule.TraceTechnologyServiceAnchorServing(r))
					)
					->union(
					    thisModule.explicitTechnologyServiceRealizations()
					        ->collect(r | thisModule.TraceTechnologyServiceRealization(r))
					)
					->union(
					    thisModule.explicitArtifactDataObjectRealizations()
					        ->collect(r | thisModule.TraceArtifactDataObjectRealization(r))
					)
					->union(
					    thisModule.derivedRealizesServiceCandidates()
					        ->collect(c | thisModule.TraceDerivedRealizesService(c))
					)
					->union(
					    thisModule.derivedAccessCandidates()
					        ->collect(c | thisModule.TraceDerivedApplicationDataAccess(c))
					)
					->union(
					    thisModule.derivedServedByCandidates()
					        ->collect(c | thisModule.TraceDerivedServedBy(c))
					)
					->union(
					    thisModule.derivedTechnologyRealizationCandidates()
					        ->collect(c | thisModule.TraceDerivedTechnologyServiceRealization(c))
					)
					->union(
					    thisModule.derivedTechnologyAccessCandidates()
					        ->collect(c | thisModule.TraceDerivedTechnologyArtifactAccess(c))
					)
					->union(
					    thisModule.derivedTechnologyServedByCandidates()
					        ->collect(c | thisModule.TraceDerivedTechnologyServedBy(c))
					)
					->union(
					    thisModule.derivedTechnologyApplicationServingCandidates()
					        ->collect(c | thisModule.TraceDerivedTechnologyApplicationServing(c))
					)
					->union(
					    thisModule.derivedApplicationBusinessContextServingCandidates()
					        ->collect(c | thisModule.TraceDerivedApplicationBusinessContextServing(c))
					)
					->union(
					    thisModule.derivedApplicationOrganizationServingCandidates()
					        ->collect(c | thisModule.TraceDerivedApplicationOrganizationServing(c))
					)
					->union(
					    thisModule.applicationCapabilityCandidates()
					        ->collect(c | thisModule.TraceDerivedApplicationCapabilitySupport(c))
					)
					->flatten()
					->asSequence()
		)
}

