            r.source.oclIsKindOf(ARCHIMATE!Node) or
            r.source.oclIsKindOf(ARCHIMATE!Device) or
            r.source.oclIsKindOf(ARCHIMATE!SystemSoftware)
        ) and
        r.target.oclIsKindOf(ARCHIMATE!TechnologyService))->asSequence();

helper def : explicitTechnologyArtifactAccesses() : Sequence(ARCHIMATE!AccessRelationship) =
    thisModule.accesses()->select(r |
        (
            r.source.oclIsKindOf(ARCHIMATE!Node) or
            r.source.oclIsKindOf(ARCHIMATE!Device) or
            r.source.oclIsKindOf(ARCHIMATE!SystemSoftware)
        ) and
