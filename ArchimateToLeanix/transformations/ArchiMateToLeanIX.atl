module ArchiMateToLeanIX;
create OUT : LEANIX, OUT2 : TRACE from IN : ARCHIMATE;

-- ============================================================================
-- Source classification
-- ============================================================================

helper context ARCHIMATE!ArchimateConcept def : isBusinessActiveStructureAnchor() : Boolean =
    self.oclIsKindOf(ARCHIMATE!BusinessActor) or
    self.oclIsKindOf(ARCHIMATE!BusinessRole);


helper def : technologyAnchors() : Sequence(ARCHIMATE!ArchimateElement) =
    ARCHIMATE!Node.allInstances()->asSequence()
        ->union(ARCHIMATE!Device.allInstances()->asSequence())
        ->union(ARCHIMATE!SystemSoftware.allInstances()->asSequence())
        ->asSequence();

helper context ARCHIMATE!ArchimateConcept def : isMaterializedElement() : Boolean =
	self.oclIsKindOf(ARCHIMATE!Goal) or
	self.oclIsKindOf(ARCHIMATE!Capability) or
	self.oclIsKindOf(ARCHIMATE!WorkPackage) or
	
	self.oclIsKindOf(ARCHIMATE!ApplicationComponent) or
	self.oclIsKindOf(ARCHIMATE!ApplicationService) or
	self.oclIsKindOf(ARCHIMATE!ApplicationInterface) or
	self.oclIsKindOf(ARCHIMATE!DataObject) or
	
	self.oclIsKindOf(ARCHIMATE!BusinessProcess) or
	self.oclIsKindOf(ARCHIMATE!BusinessFunction) or
	self.oclIsKindOf(ARCHIMATE!BusinessActor) or
	self.oclIsKindOf(ARCHIMATE!BusinessRole) or
	self.oclIsKindOf(ARCHIMATE!BusinessService) or
	self.oclIsKindOf(ARCHIMATE!BusinessObject) or
	self.oclIsKindOf(ARCHIMATE!Product) or
	
	self.oclIsKindOf(ARCHIMATE!Node) or
	self.oclIsKindOf(ARCHIMATE!Device) or
	self.oclIsKindOf(ARCHIMATE!SystemSoftware) or
	self.oclIsKindOf(ARCHIMATE!TechnologyService) or
	self.oclIsKindOf(ARCHIMATE!TechnologyInterface) or
	self.oclIsKindOf(ARCHIMATE!Artifact);

helper context ARCHIMATE!ArchimateModelObject def : safeName() : String =
    if self.name.oclIsUndefined() or self.name = '' then
        self.id
    else
        self.name
    endif;

-- ============================================================================
-- Target fact sheet resolution
-- ============================================================================

helper context ARCHIMATE!ArchimateConcept def : safeDocumentation() : String =
    if self.documentation.oclIsUndefined() then '' else self.documentation endif;

helper context ARCHIMATE!ArchimateConcept def : toLeanIXFactSheet() : OclAny =

	if self.oclIsKindOf(ARCHIMATE!Goal) then
        thisModule.Goal2Objective(self)

    else if self.oclIsKindOf(ARCHIMATE!Capability) then
        thisModule.Capability2BusinessCapability(self)

    else if self.oclIsKindOf(ARCHIMATE!WorkPackage) then
        thisModule.WorkPackage2Initiative(self)

    else if self.oclIsKindOf(ARCHIMATE!ApplicationComponent) then
        thisModule.ApplicationComponent2Application(self)

    else if self.oclIsKindOf(ARCHIMATE!ApplicationService) then
        thisModule.ApplicationService2CustomService(self)

    else if self.oclIsKindOf(ARCHIMATE!ApplicationInterface) then
        thisModule.ApplicationInterface2Interface(self)

    else if self.oclIsKindOf(ARCHIMATE!DataObject) then
        thisModule.DataObject2DataObject(self)

    else if self.oclIsKindOf(ARCHIMATE!BusinessProcess) then
        thisModule.BusinessProcess2BusinessContext(self)

    else if self.oclIsKindOf(ARCHIMATE!BusinessFunction) then
        thisModule.BusinessFunction2BusinessContext(self)

    else if self.oclIsKindOf(ARCHIMATE!BusinessActor) then
        thisModule.BusinessActor2Organization(self)

    else if self.oclIsKindOf(ARCHIMATE!BusinessRole) then
        thisModule.BusinessRole2Organization(self)

    else if self.oclIsKindOf(ARCHIMATE!BusinessService) then
        thisModule.BusinessService2CustomService(self)

    else if self.oclIsKindOf(ARCHIMATE!BusinessObject) then
        thisModule.BusinessObject2DataObject(self)

    else if self.oclIsKindOf(ARCHIMATE!Product) then
        thisModule.Product2BusinessContext(self)
		
	else if self.oclIsKindOf(ARCHIMATE!Node) then
        thisModule.Node2ITComponent(self)
		
	else if self.oclIsKindOf(ARCHIMATE!Device) then
        thisModule.Device2ITComponent(self)
		
	else if self.oclIsKindOf(ARCHIMATE!SystemSoftware) then
		thisModule.SystemSoftware2ITComponent(self)
		
	else if self.oclIsKindOf(ARCHIMATE!TechnologyService) then
	    thisModule.TechnologyService2CustomService(self)
	
	else if self.oclIsKindOf(ARCHIMATE!TechnologyInterface) then
	    thisModule.TechnologyInterface2Interface(self)
	
	else
	    if self.oclIsKindOf(ARCHIMATE!Artifact) then
	        thisModule.Artifact2DataObject(self)
	    else
	        OclUndefined
	    endif
    endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif endif;

-- ============================================================================
-- Relationship navigation
-- ============================================================================

helper def : assignments() : Sequence(ARCHIMATE!AssignmentRelationship) =
    ARCHIMATE!AssignmentRelationship.allInstances()->asSequence();

helper def : compositions() : Sequence(ARCHIMATE!CompositionRelationship) =
    ARCHIMATE!CompositionRelationship.allInstances()->asSequence();

helper def : aggregations() : Sequence(ARCHIMATE!AggregationRelationship) =
    ARCHIMATE!AggregationRelationship.allInstances()->asSequence();

helper def : realizations() : Sequence(ARCHIMATE!RealizationRelationship) =
    ARCHIMATE!RealizationRelationship.allInstances()->asSequence();

helper def : accesses() : Sequence(ARCHIMATE!AccessRelationship) =
    ARCHIMATE!AccessRelationship.allInstances()->asSequence();

helper def : servings() : Sequence(ARCHIMATE!ServingRelationship) =
    ARCHIMATE!ServingRelationship.allInstances()->asSequence();

helper def : flows() : Sequence(ARCHIMATE!FlowRelationship) =
    ARCHIMATE!FlowRelationship.allInstances()->asSequence();

helper def : specializations() : Sequence(ARCHIMATE!SpecializationRelationship) =
	ARCHIMATE!SpecializationRelationship.allInstances()->asSequence();

helper context ARCHIMATE!ArchimateRelationship def : hasSameMaterializedTypeEndpoints() : Boolean =
	self.source.isMaterializedElement() and
	self.target.isMaterializedElement() and
	self.source.oclType() = self.target.oclType();

-- ============================================================================
-- Explicit relationship pattern filters
-- ============================================================================

helper def : explicitSameTypeCompositions()
    : Sequence(ARCHIMATE!CompositionRelationship) =
    thisModule.compositions()
        ->select(r | r.hasSameMaterializedTypeEndpoints())
        ->asSequence();

helper def : explicitSameTypeAggregations()
    : Sequence(ARCHIMATE!AggregationRelationship) =
    thisModule.aggregations()
        ->select(r | r.hasSameMaterializedTypeEndpoints())
        ->asSequence();


helper def : explicitSameTypeSpecializations()
    : Sequence(ARCHIMATE!SpecializationRelationship) =
    thisModule.specializations()
        ->select(r | r.hasSameMaterializedTypeEndpoints())
        ->asSequence();

-- Business relationships

helper def : explicitActorRoleAssignments() : Sequence(ARCHIMATE!AssignmentRelationship) =
    thisModule.assignments()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!BusinessActor) and
        r.target.oclIsKindOf(ARCHIMATE!BusinessRole))->asSequence();

helper def : explicitBusinessContextAssignments() : Sequence(ARCHIMATE!AssignmentRelationship) =
    thisModule.assignments()->select(r |
        r.source.isBusinessActiveStructureAnchor() and
        (
            r.target.oclIsKindOf(ARCHIMATE!BusinessProcess) or
            r.target.oclIsKindOf(ARCHIMATE!BusinessFunction)
        ))->asSequence();

helper def : explicitProcessServiceRealizations() : Sequence(ARCHIMATE!RealizationRelationship) =
    thisModule.realizations()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!BusinessProcess) and
        r.target.oclIsKindOf(ARCHIMATE!BusinessService))->asSequence();

helper def : explicitFunctionServiceRealizations() : Sequence(ARCHIMATE!RealizationRelationship) =
    thisModule.realizations()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!BusinessFunction) and
        r.target.oclIsKindOf(ARCHIMATE!BusinessService))->asSequence();

helper def : explicitProcessBusinessObjectAccesses() : Sequence(ARCHIMATE!AccessRelationship) =
    thisModule.accesses()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!BusinessProcess) and
        r.target.oclIsKindOf(ARCHIMATE!BusinessObject))->asSequence();

helper def : explicitFunctionBusinessObjectAccesses() : Sequence(ARCHIMATE!AccessRelationship) =
    thisModule.accesses()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!BusinessFunction) and
        r.target.oclIsKindOf(ARCHIMATE!BusinessObject))->asSequence();

helper def : explicitBusinessServiceOrganizationServings() : Sequence(ARCHIMATE!ServingRelationship) =
    thisModule.servings()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!BusinessService) and
        r.target.isBusinessActiveStructureAnchor())->asSequence();

helper def : explicitBusinessServiceBusinessObjectAccesses() : Sequence(ARCHIMATE!AccessRelationship) =
    thisModule.accesses()->select(r |
            r.source.oclIsKindOf(ARCHIMATE!BusinessService) and
            r.target.oclIsKindOf(ARCHIMATE!BusinessObject))->asSequence();

helper def : explicitApplicationServiceProcessServings() : Sequence(ARCHIMATE!ServingRelationship) =
    thisModule.servings()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!ApplicationService) and
        r.target.oclIsKindOf(ARCHIMATE!BusinessProcess))->asSequence();

helper def : explicitApplicationServiceFunctionServings() : Sequence(ARCHIMATE!ServingRelationship) =
    thisModule.servings()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!ApplicationService) and
        r.target.oclIsKindOf(ARCHIMATE!BusinessFunction))->asSequence();

helper def : explicitApplicationBusinessContextServings() : Sequence(ARCHIMATE!ServingRelationship) =
    thisModule.servings()->select(r |
        r.source.oclIsKindOf(ARCHIMATE!ApplicationComponent) and
