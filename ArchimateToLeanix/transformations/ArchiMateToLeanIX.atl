            targetArtifact <- targetRef
        ),

        sourceRef : TRACE!SourceArtifactReference (
            artifactId <- r.id,
            artifactType <- 'RealizationRelationship',
            sourceObject <- r
        ),

        targetRef : TRACE!RelationTargetReference (
            artifactId <- 'rel-' + r.id,
            artifactType <- 'FactSheetRelation',
            targetObject <-
                thisModule.CreateArtifactDataObjectRealization(r)
        )
}

