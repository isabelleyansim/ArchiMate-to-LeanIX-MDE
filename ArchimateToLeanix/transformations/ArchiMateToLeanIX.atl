helper def : derivedTechnologyServedByCandidates() : Sequence(OclAny) =
    thisModule.technologyAnchors()
        ->collect(tech |

            tech.technologyAnchoredBehaviorPaths()->collect(p |

                thisModule.servings()
                    ->select(r |
                        r.target = p.behavior and
                        r.source.oclIsKindOf(ARCHIMATE!TechnologyService)
                    )
                    ->collect(r |
                        Tuple {
                            tech = tech,
                            service = r.source,

                            evidenceBehavior = p.behavior,
                            evidenceRelation = r,

                            traceArtifacts =
                                p.path
                                    ->including(r)
                                    ->including(r.source),

                            key =
                                tech.id +
                                '|servedByTechnologyService|' +
                                r.source.id
                        }
                    )
            )->flatten()
        )->flatten()
