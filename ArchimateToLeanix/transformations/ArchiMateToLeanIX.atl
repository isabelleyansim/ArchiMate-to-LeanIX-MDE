-- Technology relationships

helper def : explicitTechnologyContainmentCompositions() : Sequence(ARCHIMATE!CompositionRelationship) =
    thisModule.compositions()->select(r |
            (
                r.source.oclIsKindOf(ARCHIMATE!Node) and
                (
                    r.target.oclIsKindOf(ARCHIMATE!Device) or
                    r.target.oclIsKindOf(ARCHIMATE!SystemSoftware)
                )
            )
            or
            (
                r.source.oclIsKindOf(ARCHIMATE!Device) and
                r.target.oclIsKindOf(ARCHIMATE!SystemSoftware)
            ))->asSequence();

helper def : explicitTechnologyContainmentAggregations() : Sequence(ARCHIMATE!AggregationRelationship) =
    thisModule.aggregations()->select(r |
            (
                r.source.oclIsKindOf(ARCHIMATE!Node) and
                (
                    r.target.oclIsKindOf(ARCHIMATE!Device) or
                    r.target.oclIsKindOf(ARCHIMATE!SystemSoftware)
                )
            )
            or
            (
                r.source.oclIsKindOf(ARCHIMATE!Device) and
                r.target.oclIsKindOf(ARCHIMATE!SystemSoftware)
            ))->asSequence();

helper def : explicitTechnologyHostAssignments() : Sequence(ARCHIMATE!AssignmentRelationship) =
    thisModule.assignments()->select(r |
        (
            r.source.oclIsKindOf(ARCHIMATE!Device) or
            r.source.oclIsKindOf(ARCHIMATE!SystemSoftware)
